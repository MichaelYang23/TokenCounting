{
  "name": "tokencount-api",
  "private": true,
  "type": "module",
  "description": "API for the TokenCounting shared dataset (Cloudflare Worker + D1).",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --no-warnings --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply tokencount --local",
    "migrate:remote": "wrangler d1 migrations apply tokencount --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.161.0"
  }
}
