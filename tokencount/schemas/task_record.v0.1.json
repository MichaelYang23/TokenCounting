{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MichaelYang23/TokenCounting/blob/main/tokencount/schemas/task_record.v0.1.json",
  "title": "TokenCounting task record, v0.1",
  "description": "One AI-agent task: a human prompt plus every model call made until the next human prompt, sub-agents included. Records hold token counts, not dollars; cost is derived from a dated price table. No prompt text unless the contributor opted in.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "harness", "importer", "date", "primary_model", "effort", "turns", "subagent_calls", "duration_s", "peak_context_tokens", "tools", "server_tools", "calls", "task", "outcome"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "record_id": {
      "description": "HMAC-SHA256 of the local session and prompt IDs under a secret salt that never leaves the contributor's machine: stable across re-exports, not linkable to the logs.",
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "harness": {
      "description": "The agent or app that made the calls.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "version": {"type": ["string", "null"]}
      }
    },
    "importer": {"description": "Tool and version that produced the record.", "type": "string"},
    "date": {"description": "UTC date the task started. No time of day.", "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "primary_model": {"description": "Model behind most main-thread calls.", "type": "string"},
    "effort": {"description": "Most common reasoning effort of main-thread calls (null if the log does not say).", "type": ["string", "null"]},
    "turns": {"description": "Main-thread model calls: rounds of the agent loop.", "type": "integer", "minimum": 0},
    "subagent_calls": {"description": "Model calls made by sub-agents.", "type": "integer", "minimum": 0},
    "duration_s": {"description": "Wall-clock seconds from the prompt to the last logged response.", "type": ["integer", "null"], "minimum": 0},
    "peak_context_tokens": {"description": "Largest main-thread prompt (fresh + cached input) of any call.", "type": "integer", "minimum": 0},
    "tools": {
      "description": "Tool calls by name. Built-in tool names are kept; MCP tools are counted as \"mcp\" and anything else as \"other\".",
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "server_tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web_search_requests"],
      "properties": {
        "web_search_requests": {"type": "integer", "minimum": 0}
      }
    },
    "calls": {
      "description": "Every billed model call, in order.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "model", "effort", "speed", "inference_geo", "input_fresh", "cache_write_5m", "cache_write_1h", "cache_read", "output", "thinking"],
        "properties": {
          "role": {"enum": ["main", "subagent"]},
          "model": {"type": "string"},
          "effort": {"type": ["string", "null"]},
          "speed": {"type": ["string", "null"]},
          "inference_geo": {"type": ["string", "null"]},
          "input_fresh": {"description": "Uncached input tokens.", "type": "integer", "minimum": 0},
          "cache_write_5m": {"type": "integer", "minimum": 0},
          "cache_write_1h": {"type": "integer", "minimum": 0},
          "cache_read": {"type": "integer", "minimum": 0},
          "output": {"description": "All output tokens, thinking included.", "type": "integer", "minimum": 0},
          "thinking": {"description": "Thinking tokens within output; null when the provider did not report them.", "type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "category", "description", "prompt_chars", "prompt"],
      "properties": {
        "kind": {"enum": ["prompt", "command", "continuation"]},
        "category": {"enum": [null, "feature", "bugfix", "refactor", "review", "explain", "research", "writing", "data", "ops", "other"]},
        "description": {"description": "One line written or approved by the contributor.", "type": ["string", "null"], "maxLength": 300},
        "prompt_chars": {"type": ["integer", "null"], "minimum": 0},
        "prompt": {"description": "Full prompt text, only if the contributor opted in.", "type": ["string", "null"]}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "interrupted"],
      "properties": {
        "label": {"enum": ["success", "partial", "fail", "unknown"]},
        "interrupted": {"description": "The user stopped the agent mid-task.", "type": "boolean"}
      }
    }
  }
}
